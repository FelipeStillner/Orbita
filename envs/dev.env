# Server Configuration
PORT=8080
ENV=development

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=orbita_user
DB_PASSWORD=orbita_pass
DB_NAME=orbita_db
DB_SSLMODE=disable

# Full Connection String
DATABASE_URL=postgres://orbita_user:orbita_pass@localhost:5432/orbita_db?sslmode=disable

# Auth: JWT signing secret
JWT_SECRET=your-jwt-secret-change-in-production
